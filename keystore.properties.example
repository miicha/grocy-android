# Copy to keystore.properties (git-ignored) to build signed release APKs.
#
# Create the keystore once and keep it safe -- if it is lost, already
# installed copies of the app can never be updated again, they have to be
# uninstalled (losing their local cache) and installed fresh:
#
#   keytool -genkey -v -keystore grocy-subloc.jks -alias subloc \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved relative to the repository root.
storeFile=grocy-subloc.jks
storePassword=changeme
keyAlias=subloc
keyPassword=changeme
